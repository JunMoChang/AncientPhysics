--- !u!114 &850967724
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 850967723}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a184f3868732d5a45b35f66ccc59f62d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueIDDatas:
  - dialogueDataID: PryBalanceScene-Enter
    dialogueDatas:
    - speakerName: "\u795E\u79D8\u4EBA"
      contexts:
      - "\u4F60\u597D\u554A\u5C0F\u670B\u53CB\u3002"
      - "\u5B69\u5B50\u4E0D\u8981\u5BB3\u6015\uFF0C\u8FD9\u4E2A\u5730\u65B9\u5F88\u5B89\u5168\u3002"
      - "\u548C\u6211\u4E00\u8D77\u73A9\u4E2A\u6E38\u620F\u600E\u4E48\u6837\u5440\u3002"
      - "\u770B\u770B\u4F60\u7684\u5468\u56F4\uFF0C\u8BD5\u7740\u63A5\u89E6\u5B83\u4EEC\u5427\uFF0C\u901A\u5173\u540E\uFF0C\u6211\u4F1A\u518D\u6B21\u51FA\u73B0\u7684\u3002"
      - "\u7ED9\u4F60\u70B9\u63D0\u793A\u5427\u3002\u7ECF\u4E0B\u4E2D\u6709\u63D0\u5230\uFF0C\u201C\u8D1F\uFF0C\u8861\u6728\uFF0C\u52A0\u91CD\u7109\uFF0C\u800C\u4E0D\u6320\uFF0C\u6781\u80DC\u91CD\u4E5F\u3002\u53F3\u6821\u4EA4\u7EF3\uFF0C\u65E0\u52A0\u7109\u800C\u6320\uFF0C\u6781\u4E0D\u80DC\u91CD\u4E5F\u3002\u8861\uFF0C\u52A0\u91CD\u4E8E\u5176\u4E00\u65C1\uFF0C\u5FC5\u6376\u3002\u6743\u91CD\u76F8\u82E5\u4E5F\u76F8\u8861\uFF0C\u5219\u672C\u77ED\u6807\u957F\u3002\u4E24\u52A0\u7109\uFF0C\u91CD\u76F8\u82E5\uFF0C\u5219\u6807\u5FC5\u4E0B\uFF0C\u6807\u5F97\u6743\u4E5F\u3002\u201D "
      - "\u597D\u597D\u60F3\u4E00\u60F3\uFF0C\u609F\u4E00\u609F\uFF0C\u4F1A\u660E\u767D\u7684\u3002"
      - ......
    - speakerName: "\u6211"
      contexts:
      - "\u8C01\u5440?\u8C01\u5728\u8BF4\u8BDD?"
      - "\u4EC0\u4E48?\u4F60\u662F\u8C01?\u4F60\u60F3\u5E72\u4EC0\u4E48?"
      - "\u6E38\u620F?\u4EC0\u4E48\u6E38\u620F?"
      - "\u554A?\u8981\u662F\u901A\u5173\u4E0D\u4E86\uFF0C\u6211\u8BE5\u600E\u4E48\u529E?"
      - "\u8FD9\u4E5F\u592A\u62BD\u8C61\u4E86\u5427\uFF0C\u6211\u542C\u4E0D\u61C2\u554A\uFF01"
      - "\u7B49\u4E00\u4E0B\uFF0C\u7B49\u4E00\u4E0B\u3002\u518D\u591A\u7ED9\u70B9\u63D0\u793A\u3002"
      - "\u4EBA\u5462?\u8FD9\u5C31\u8D70\u4E86?\u592A\u4E0D\u8D1F\u8D23\u4EFB\u4E86\u5427\uFF01\u54CE\uFF0C\u56DB\u5904\u770B\u770B\u5427\u3002"
  - dialogueDataID: PryBalanceScene-End
    dialogueDatas:
    - speakerName: "\u795E\u79D8\u4EBA"
      contexts:
      - "\u4EFB\u52A1\u5B8C\u6210\u7684\u5F88\u51FA\u8272\u561B\u3002"
      - "\u4E0D\u8981\u7740\u6025\uFF0C\u8FD8\u6709\u51E0\u4E2A\u5173\u5361\u5728\u7B49\u7740\u4F60\u3002"
      - "\u5C31\u5F53\u51FA\u6765\u65C5\u6E38\u4E86\uFF0C\u4F60\u73B0\u5728\u56DE\u53BB\u8FD8\u662F\u8981\u53BB\u5199\u4F60\u7684\u4F5C\u4E1A"
      - "\u600E\u4E48\u4F60\u60F3\u56DE\u53BB\u5199\u4F5C\u4E1A\u5417?"
    - speakerName: "\u6211"
      contexts:
      - "\u4F60\u8FD8\u771F\u7684\u56DE\u6765\u4E86\uFF0C\u90A3\u6211\u73B0\u5728\u53EF\u4EE5\u56DE\u53BB\u4E86\u5427\u3002"
      - "\u4EC0\u4E48?\u4F60\u5728\u9017\u6211\u73A9\u5462\u3002"
      - 
      - "\u6709\u70B9\u9053\u7406\uFF0C\u90A3\u5C31\u4E0B\u4E00\u5173\u5427\uFF0C\u8D70\u7740\u3002"
  - dialogueDataID: PulleyScene-Enter
    dialogueDatas:
    - speakerName: "\u795E\u79D8\u4EBA"
      contexts:
      - "\u6B22\u8FCE\u6765\u5230\u7B2C\u4E8C\u5173\u3002\u8FD9\u4E00\u5173\u4F60\u4F1A\u63A5\u89E6\u5230\u6ED1\u8F6E\u3002"
      - "\u5728\u7ECF\u4E0B\u6709\u63D0\u5230\uFF0C\u201C\u6308\uFF1A\u6709\u529B\u4E5F\uFF1B\u5F15\uFF0C\u65E0\u529B\u4E5F\uFF0C\u4E0D\u5FC3\u3002\u6240\u6308\u4E4B\u6B62\u4E8E\u65BD\u4E5F\uFF0C\u7EF3\u5236\u6308\u4E4B\u4E5F\uFF0C\u82E5\u4EE5\u9525\u523A\u4E4B\u3002\u6308\uFF0C\u957F\u91CD\u8005\u4E0B\uFF0C\u77ED\u8F7B\u8005\u4E0A\uFF0C\u4E0A\u8005\u6108\u5F97\uFF0C\u4E0B\u4E0B\u8005\u6108\u4EA1\u3002\u201D"
      - "\u5FEB\u53BB\u4F53\u9A8C\u4F53\u9A8C\u5427\u3002\u5BF9\u4E86\uFF0C\u53EF\u4EE5\u6CE8\u610F\u4E00\u4E0B\u684C\u5B50\uFF0C\u8BF4\u4E0D\u5B9A\u6709\u65B0\u53D1\u73B0\u54E6\u3002"
    - speakerName: "\u6211"
      contexts:
      - 
      - 
      - "\u611F\u89C9\u597D\u590D\u6742\u3002"
  - dialogueDataID: PulleyScene-End
    dialogueDatas:
    - speakerName: "\u795E\u79D8\u4EBA"
      contexts:
      - "\u611F\u89C9\u600E\u4E48\u6837?"
      - "\u90A3\u5F53\u7136\uFF0C\u8FD8\u4F1A\u6709\u66F4\u591A\u7684\u7EC4\u5408\u7ED3\u6784\uFF0C\u9700\u8981\u4F60\u81EA\u5DF1\u53D1\u73B0\u4E86\u3002"
      - 
      - "\u597D\u4E86\uFF0C\u51C6\u5907\u8FDB\u5165\u4E0B\u4E00\u5173\u4E86\u3002"
    - speakerName: "\u6211"
      contexts:
      - "\u6ED1\u8F6E\u7EC4\u786E\u5B9E\u80FD\u65B9\u4FBF\u7684\u63D0\u5347\u91CD\u7269\u3002\u81EA\u5DF1\u5C31\u8F7B\u677E\u591A\u4E86\u3002"
      - "\u4E0D\u540C\u7EC4\u5408\u4F1A\u6709\u4E0D\u540C\u7684\u6548\u7387\uFF0C\u8FD9\u4E2A\u6211\u5B66\u8FC7\uFF0C\u4F46\u662F\u989D...\u5B66\u7684\u4E0D\u592A\u597D\u3002"
      - "\u73B0\u5728\u611F\u89C9\u8FD8\u633A\u6709\u610F\u601D\u7684\u3002"
  - dialogueDataID: KeyholeImageScene-Enter
    dialogueDatas:
    - speakerName: "\u795E\u79D8\u4EBA"
      contexts:
      - "\u6B22\u8FCE\u6765\u5230\u6700\u540E\u4E00\u5173\uFF0C\u52A0\u6CB9\uFF01"
      - "\u9ED1\u4E00\u70B9\u66F4\u6709\u4F53\u9A8C\u611F\u54E6\u3002\u8FD9\u5173\u548C\u5149\u6709\u5173\u3002"
      - 
    - speakerName: "\u6211"
      contexts:
      - "\u600E\u4E48\u8FD9\u4E48\u9ED1\uFF0C\u4EC0\u4E48\u60C5\u51B5?"
      - "\u8FD9\u4E48\u9ED1\uFF0C\u54EA\u6765\u7684\u5149?"
      - "\u6B38\uFF0C\u90A3\u91CC\u597D\u50CF\u6709\u8721\u70DB\uFF0C\u53BB\u770B\u770B\u3002"
  - dialogueDataID: KeyholeImageScene-End
    dialogueDatas:
    - speakerName: "\u795E\u79D8\u4EBA"
      contexts:
      - "\u6700\u540E\u4E00\u5173\u4E5F\u5706\u6EE1\u5B8C\u6210\u4E86\uFF0C\u771F\u662F\u4E0D\u9519\u3002"
      - 
      - "\u8FD9\u4E9B\u7269\u7406\u77E5\u8BC6\u5176\u5B9E\u633A\u597D\u7406\u89E3\u7684\u5427\u3002"
      - "\u4F60\u80FD\u8FD9\u4E48\u60F3\u90A3\u53EF\u592A\u597D\u4E86\uFF0C\u4EE5\u540E\u53EF\u8981\u597D\u597D\u5B66\u4E60\u3002"
      - "\u65F6\u95F4\u5DEE\u4E0D\u591A\u4E86\uFF0C\u6211\u4E5F\u8BE5\u9001\u4F60\u56DE\u53BB\u4E86\u3002"
      - 
      - "\u54C8\u54C8\u54C8\uFF0C\u4F1A\u6709\u673A\u4F1A\u7684\uFF0C\u518D\u4F1A\u5B69\u5B50\u3002"
    - speakerName: "\u6211"
      contexts:
      - "\u90A3\u5F53\u7136\u4E86\uFF0C\u8FD9\u4E9B\u90FD\u5C0F\u83DC\u4E00\u789F\u3002\u6700\u540E\u4E00\u5173\u662F\u5C0F\u5B54\u6210\u50CF\uFF0C\u6211\u4E5F\u542C\u8001\u5E08\u8BF4\u8FC7\u3002"
      - "\u867D\u7136\u542C\u7684\u5F88\u968F\u610F\uFF0C\u4E0D\u8FC7\u73B0\u5728\u53C8\u61C2\u4E86\u4E0D\u5C11\u3002"
      - "\u55EF......\u597D\u50CF\u8FD8\u771F\u662F\uFF0C\u6760\u6746\u539F\u7406\uFF0C\u6ED1\u8F6E\u7EC4\uFF0C\u5C0F\u5B54\u6210\u50CF\uFF0C\u4EE5\u524D\u89C9\u5F97\u597D\u5934\u75BC\uFF0C\u73B0\u5728\u611F\u89C9\u8FD8\u633A\u6709\u8DA3\u7684\u3002"
      - "\u4F60\u627E\u6211\u6765\u5C31\u662F\u8FD9\u4E2A\u76EE\u7684\u554A\uFF0C\u8BF4\u7684\u4E5F\u662F\uFF0C\u8C22\u8C22\u4F60\u4E86\u3002"
      - "\u7EC8\u4E8E\u80FD\u56DE\u53BB\u4E86\uFF0C\u6709\u70B9\u60F3\u5FF5\u6211\u7684\u5E8A\u4E86\uFF0C\u4E0D\u8FC7\u597D\u50CF\u8FD8\u6709\u70B9\u4E0D\u820D\u5462\u3002"
      - "\u6211\u8FD8\u6709\u673A\u4F1A\u518D\u6765\u5417?"
  canvas: {fileID: 0}
